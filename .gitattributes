# GitHub's language bar counts what people write, not what a tool generates. The files below are
# generated, so they are marked and left out of the statistics (and the diffs of generated files
# are collapsed by default on GitHub). Added on 1 November 2026 with the TypeScript build
# (TS-STEP-1), on GDPRLetterBuilder's and UsernameGenerator's .gitattributes.
#
# They are every JavaScript file in the repository, and nothing else: the compiled files, written
# by tools/build-ts.sh (edit the TypeScript, never the .js), and gate.js. tests/tooling.test.ts
# checks that this list and the JavaScript in the tree agree.
#
# gate.js, the first-run notice, is written by build-gates.py at the root of the GitHub folder,
# shared by every Labs app; it is not edited here.
/gate.js linguist-generated=true
# The engine's modules, compiled from ts/src/.
/src/core/bytes.js linguist-generated=true
/src/core/taxonomy.js linguist-generated=true
/src/core/c2pa.js linguist-generated=true
/src/core/icc.js linguist-generated=true
/src/core/tiff.js linguist-generated=true
/src/core/iptc.js linguist-generated=true
/src/core/xmp.js linguist-generated=true
/src/core/webp.js linguist-generated=true
/src/core/heic.js linguist-generated=true
/src/core/png.js linguist-generated=true
/src/core/jpeg.js linguist-generated=true
/src/scrub-core.js linguist-generated=true
# The interface, compiled from ts/app.ts.
/app.js linguist-generated=true
# The Android app's bridge script (only in the APK), compiled from android/web-overlay/android-bridge.ts.
/android/web-overlay/android-bridge.js linguist-generated=true
