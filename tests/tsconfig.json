// The tests' program (strict, noEmit). Node 24 runs tests/*.ts directly, and tools/build-ts.sh
// type-checks them. A test imports the engine as "#src/x.js": "imports" in package.json gives
// Node the served, compiled ./src/x.js, so the tests always run what ships, and gives the checker
// the types of ./ts/src/x.ts (the "types" condition).
{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "*.ts"
  ]
}
