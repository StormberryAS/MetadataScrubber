// The tests' program (strict, noEmit). Node 24 runs tests/*.ts directly; tools/build-ts.sh
// type-checks them once the first one exists. Until the last module is TypeScript (TS-STEP-1),
// allowJs, checkJs and paths let a test import "#src/x.js" and get the types of ts/src/x.ts when
// that source exists, or of the hand-written src/x.js (unchecked here) when it does not. Node
// itself maps "#src/*" to the served ./src/* through "imports" in package.json, so the tests
// always run what ships. The closing commit of the move drops these three settings.
{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "#src/*": [
        "../ts/src/*",
        "../src/*"
      ]
    }
  },
  "include": [
    "*.ts"
  ]
}
