{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rootDir": "ts",
    "outDir": ".",
    "newLine": "lf",
    "removeComments": true,
    "noEmitOnError": true
  },
  "include": [
    "ts/**/*.ts"
  ],
  "exclude": [
    "ts/core-env.d.ts"
  ]
}
