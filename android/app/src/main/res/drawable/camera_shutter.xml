<?xml version="1.0" encoding="utf-8"?>
<!-- The shutter (1.1.0): a white ring around a white disc, pink while pressed or focused,
     grey while the photo is being prepared. A thin dark edge outside the ring keeps it
     visible over a bright scene, where the preview runs behind it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="2dp" android:color="@color/camera_shutter_edge" />
                </shape>
            </item>
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape android:shape="oval">
                    <stroke android:width="4dp" android:color="@color/camera_disabled" />
                </shape>
            </item>
            <item android:bottom="10dp" android:left="10dp" android:right="10dp" android:top="10dp">
                <shape android:shape="oval">
                    <solid android:color="@color/camera_disabled" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="2dp" android:color="@color/camera_shutter_edge" />
                </shape>
            </item>
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape android:shape="oval">
                    <stroke android:width="4dp" android:color="@color/camera_text" />
                </shape>
            </item>
            <item android:bottom="10dp" android:left="10dp" android:right="10dp" android:top="10dp">
                <shape android:shape="oval">
                    <solid android:color="@color/camera_accent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="2dp" android:color="@color/camera_shutter_edge" />
                </shape>
            </item>
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape android:shape="oval">
                    <stroke android:width="4dp" android:color="@color/camera_accent" />
                </shape>
            </item>
            <item android:bottom="10dp" android:left="10dp" android:right="10dp" android:top="10dp">
                <shape android:shape="oval">
                    <solid android:color="@color/camera_text" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="2dp" android:color="@color/camera_shutter_edge" />
                </shape>
            </item>
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape android:shape="oval">
                    <stroke android:width="4dp" android:color="@color/camera_text" />
                </shape>
            </item>
            <item android:bottom="10dp" android:left="10dp" android:right="10dp" android:top="10dp">
                <shape android:shape="oval">
                    <solid android:color="@color/camera_text" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
