<?xml version="1.0" encoding="utf-8"?>
<!-- The page's pink button (btn-primary in style.css), for the camera's explanation (1.1.0). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/camera_border">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="315"
                android:endColor="@color/camera_accent_strong"
                android:startColor="@color/camera_accent_light" />
        </shape>
    </item>
</ripple>
