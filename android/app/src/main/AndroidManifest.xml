<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      This app declares ONE permission, CAMERA, used only by the in-app camera screen
      (CameraActivity, 1.1.0), and asked for only when the user taps Take a photo, after the
      app's own explanation. Nothing else, on purpose.

      Pictures come in through the system file picker (Storage Access Framework) or a share
      from another app; both hand over a one-off read grant for the chosen files, so no
      storage permission is needed. Saving goes through the system "create document"
      screen, which needs none either. A photo taken in the app stays in its private cache
      and never goes to the gallery, so it needs no storage permission either. There is no
      INTERNET permission, so the WebView cannot reach the network at all, whatever the
      page tried.

      The camera is not required: a device without one still installs the app, and Take a
      photo then says the device has no camera. Declaring the feature as not required also
      stops Android and the stores from implying android.hardware.camera and
      android.hardware.camera.autofocus as requirements from the CAMERA permission.

      CameraX also merges in androidx.camera.core.impl.MetadataHolderService, disabled and
      not exported: a holder of build-time settings that never runs and that no other app
      can reach. No CameraX library adds a permission.

      The other entries below are explicit removals: if any dependency ever merges these
      in, the build strips them back out. Verify with `aapt dump permissions` on the APK:
      the only lines must be the package name and android.permission.CAMERA.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />

    <!--
      androidx.core declares a private signature permission for its registerReceiver
      compatibility shim. It grants nothing to anyone but this app, yet it still shows up in
      `aapt dump permissions`. This app registers no broadcast receivers at run time (its one
      receiver, for the clipboard alarm, is declared below and needs no permission), so both
      halves of it are removed.
    -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!--
      NO BACKUP. allowBackup="false" disables cloud and adb backup; both rule files exclude
      everything as well, because device-to-device transfer is not governed by allowBackup.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MetadataScrubber">

        <!-- The WebView must not report usage metrics to Google. -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />
        <!--
          Safe Browsing checks URLs against Google's lists, which means sending lookups off
          the device. The WebView here can only load the bundled page and has no network
          access, so the check has nothing to protect and is switched off.
        -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />

        <!--
          configChanges keeps the activity, and with it the WebView and the picture the user
          loaded, alive across rotation, resizing, keyboard, dark-mode, language, text-size
          and bold-text changes. Recreating it would reload the page and lose the work.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection|fontWeightAdjustment|colorMode|touchscreen"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MetadataScrubber">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share one picture or several into the app from a gallery or file manager. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/webp" />
                <data android:mimeType="image/heic" />
                <data android:mimeType="image/heif" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/webp" />
                <data android:mimeType="image/heic" />
                <data android:mimeType="image/heif" />
            </intent-filter>
        </activity>

        <!--
          The in-app camera (1.1.0): a shutter, a front or back switch and, where the camera
          has one, a flash toggle. Not exported, so only MainActivity can start it, and only
          its own shutter button ever takes a photo. configChanges as for MainActivity, so
          turning the phone never recreates it in the middle of a photo; it is not locked to
          portrait, because Android 16 ignores that on large screens at targetSdk 36.
        -->
        <activity
            android:name=".CameraActivity"
            android:exported="false"
            android:label="@string/camera_title"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection|fontWeightAdjustment|colorMode|touchscreen"
            android:theme="@style/Theme.MetadataScrubber.Camera" />

        <!--
          androidx.profileinstaller adds an exported receiver for adb and benchmarking tools.
          It is guarded by the DUMP permission, so no ordinary app could reach it, but it is
          not needed either: the startup initialiser still installs the baseline profile.
          Removing it keeps the exported surface to the launcher and the share targets.
          Lint's MissingClass check looks at this source file, where the class name is
          only a removal marker, so it is silenced for this one element.
        -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />

        <!--
          A guard for later (1.1.0): appcompat 1.4 and later bring emoji2, whose start-up
          initialiser asks Google Play services' font provider for fonts, with no permission
          needed, so the permission check could not catch it. CameraX's camera-view pulls in
          appcompat (1.1.0 today, without emoji2). Should a future version bring emoji2, this
          removes its initialiser from androidx.startup, which profileinstaller already uses.
          Today it removes nothing. androidx.startup is only on the runtime classpath, so
          lint's MissingClass check cannot see the provider class from this file and is
          silenced for this one element, as for the receiver above.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:ignore="MissingClass"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>

        <!--
          Ends a copied picture's 2 minutes (1.0.1) and a shared file's 10 minutes (1.1.0)
          while the app is in the background: an inexact AlarmManager alarm, which needs no
          permission, wakes the app to delete them. Not exported, so only the app's own
          PendingIntent can reach it.
        -->
        <receiver
            android:name=".ClipExpiryReceiver"
            android:exported="false" />

        <!--
          Shares the finished file with the app the user picks, and serves the copied picture
          to the app it is pasted into. Not exported: other apps get a one-off read grant for
          one file, and the paths file limits it to cache/outgoing/ and cache/clipboard/.
          OutgoingProvider is androidx's FileProvider plus one rule: a copied picture can be
          read for 2 minutes after the Copy, and a shared file for 10 minutes after the share
          (1.1.0), never after; nothing else in cache/outgoing/ is served at all.
        -->
        <provider
            android:name=".OutgoingProvider"
            android:authorities="${applicationId}.outgoing"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
